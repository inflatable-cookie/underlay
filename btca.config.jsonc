{
    "$schema": "https://btca.dev/btca.schema.json",
    "resources": [
        {
            "name": "svelte",
            "type": "git",
            "url": "https://github.com/sveltejs/svelte.dev",
            "branch": "main",
            "searchPath": "apps/svelte.dev/content",
            "specialNotes": "Svelte 5 docs. Focus on content/docs for runes, reactivity, components."
        },
        {
            "name": "svelteKit",
            "type": "git",
            "url": "https://github.com/sveltejs/kit",
            "branch": "main",
            "searchPath": "documentation",
            "specialNotes": "SvelteKit framework docs. Covers routing, load functions, form actions, hooks."
        },
        {
            "name": "vite",
            "type": "git",
            "url": "https://github.com/vitejs/vite",
            "branch": "main",
            "searchPath": "docs",
            "specialNotes": "Vite build tool documentation."
        },
        {
            "name": "typescript",
            "type": "git",
            "url": "https://github.com/microsoft/TypeScript-Website",
            "branch": "v2",
            "searchPath": "packages/documentation/copy/en",
            "specialNotes": "TypeScript handbook and reference documentation."
        },
        {
            "name": "bitsUi",
            "type": "git",
            "url": "https://github.com/huntabyte/bits-ui",
            "branch": "main",
            "searchPath": "sites/docs/src/lib/content",
            "specialNotes": "Bits UI headless component library for Svelte 5. Check components directory for API."
        },
        {
            "name": "vitest",
            "type": "git",
            "url": "https://github.com/vitest-dev/vitest",
            "branch": "main",
            "searchPath": "docs",
            "specialNotes": "Vitest testing framework documentation."
        },
        {
            "name": "marked",
            "type": "git",
            "url": "https://github.com/markedjs/marked",
            "branch": "master",
            "searchPath": "docs",
            "specialNotes": "Marked markdown parser. Check docs for options and extensions API."
        },
        {
            "name": "axum",
            "type": "git",
            "url": "https://github.com/tokio-rs/axum",
            "branch": "main",
            "searchPath": "axum",
            "specialNotes": "Axum web framework. Check axum/src for source, examples/ for usage patterns."
        },
        {
            "name": "sqlx",
            "type": "git",
            "url": "https://github.com/launchbadge/sqlx",
            "branch": "main",
            "specialNotes": "SQLx async database library. Focus on sqlx-core and sqlx-postgres for Postgres usage."
        },
        {
            "name": "tokio",
            "type": "git",
            "url": "https://github.com/tokio-rs/tokio",
            "branch": "master",
            "searchPath": "tokio",
            "specialNotes": "Tokio async runtime. Check tokio/src for core functionality."
        },
        {
            "name": "serde",
            "type": "git",
            "url": "https://github.com/serde-rs/serde",
            "branch": "master",
            "specialNotes": "Serde serialization framework. Check serde/src and serde_derive for derive macros."
        },
        {
            "name": "tower",
            "type": "git",
            "url": "https://github.com/tower-rs/tower",
            "branch": "master",
            "searchPath": "tower",
            "specialNotes": "Tower service abstractions and middleware."
        },
        {
            "name": "utoipa",
            "type": "git",
            "url": "https://github.com/juhaku/utoipa",
            "branch": "master",
            "specialNotes": "OpenAPI documentation generator for Rust. Check utoipa/src for macros and utoipa-gen for codegen."
        },
        {
            "name": "tracing",
            "type": "git",
            "url": "https://github.com/tokio-rs/tracing",
            "branch": "master",
            "searchPath": "tracing",
            "specialNotes": "Tracing framework for instrumentation. Check tracing-subscriber for formatters and filters."
        }
    ],
    "model": "minimax-m2.1-free",
    "provider": "opencode",
    "providerTimeoutMs": 300000
}
