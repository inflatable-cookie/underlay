{
  "name": "@decodelabs/underlay",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "svelte": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components": {
      "svelte": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts",
      "default": "./dist/components/index.js"
    },
    "./patterns": {
      "svelte": "./dist/patterns/index.js",
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./nightfire": {
      "svelte": "./dist/nightfire/index.js",
      "types": "./dist/nightfire/index.d.ts",
      "default": "./dist/nightfire/index.js"
    },
    "./styles": {
      "svelte": "./dist/styles/index.js",
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/http": {
      "types": "./dist/client/http.d.ts",
      "default": "./dist/client/http.js"
    },
    "./client/errors": {
      "types": "./dist/client/errors.d.ts",
      "default": "./dist/client/errors.js"
    },
    "./client/types": {
      "types": "./dist/client/types.d.ts",
      "default": "./dist/client/types.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./styles/base.css": "./dist/styles/base.css",
    "./styles/forms.css": "./dist/styles/forms.css",
    "./styles/markdown-editor.css": "./dist/styles/markdown-editor.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/optimistic.css": "./dist/styles/optimistic.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i ts/src -o dist",
    "build:watch": "svelte-package -i ts/src -o dist --watch",
    "check": "svelte-check --tsconfig ./ts/tsconfig.json",
    "check:types": "tsc -p ./ts/tsconfig.json",
    "check:exports": "node ts/scripts/check-exports.mjs",
    "check:guardrails": "node --import tsx ts/src/tools/guardrails.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "validate": "pnpm run check && pnpm run check:types && pnpm run check:exports && pnpm run check:guardrails && pnpm run test:run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "bits-ui": "^2.0.0",
    "lucide-svelte": "^0.563.0",
    "svelte": "^5.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "easymde": "^2.20.0",
    "marked": "^17.0.1",
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.10",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^25.1.0",
    "@vitest/ui": "^3.2.4",
    "bits-ui": "^2.15.5",
    "lucide-svelte": "^0.563.0",
    "svelte": "^5.49.1",
    "svelte-check": "^4.3.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "guardrails": {
    "srcDir": "./ts/src",
    "extensions": [
      ".ts",
      ".svelte"
    ],
    "bannedPatterns": [],
    "moduleScopeChecks": "@decodelabs/underlay/tools/templates/sveltekit-ssr",
    "suppressionPrefix": "guardrails-disable"
  }
}
