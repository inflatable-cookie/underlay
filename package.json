{
    "name": "@decodelabs/underlay",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "tasks": "effigy tasks",
        "health": "effigy health",
        "doctor": "effigy doctor",
        "test:plan": "effigy test --plan",
        "check": "effigy check",
        "check:types": "effigy check:types",
        "check:exports": "effigy check:exports",
        "check:component-test-hygiene": "effigy check:component-test-hygiene",
        "check:poodle-prop-names": "effigy check:poodle-prop-names",
        "check:guardrails": "effigy check:guardrails",
        "qa:docs": "effigy qa:docs",
        "qa:northstar": "effigy qa:northstar",
        "validate": "effigy validate",
        "qa": "effigy qa",
        "rust:build": "effigy rust:build",
        "rust:check": "effigy rust:check",
        "rust:test": "effigy rust:test",
        "test:components": "effigy test:components",
        "test:ui": "effigy test:ui",
        "effigy:dev": "effigy-dev"
    },
    "exports": {
        ".": {
            "svelte": "./ts/src/index.ts",
            "types": "./ts/src/index.ts",
            "default": "./ts/src/index.ts"
        },
        "./components": {
            "svelte": "./ts/src/components/index.ts",
            "types": "./ts/src/components/index.ts",
            "default": "./ts/src/components/index.ts"
        },
        "./components/*": {
            "svelte": "./ts/src/components/*",
            "types": "./ts/src/components/*",
            "default": "./ts/src/components/*"
        },
        "./patterns": {
            "svelte": "./ts/src/patterns/index.ts",
            "types": "./ts/src/patterns/index.ts",
            "default": "./ts/src/patterns/index.ts"
        },
        "./patterns/PageHeader": {
            "svelte": "./ts/src/patterns/PageHeader.svelte",
            "types": "./ts/src/patterns/PageHeader.svelte",
            "default": "./ts/src/patterns/PageHeader.svelte"
        },
        "./patterns/FormDialog": {
            "types": "./ts/src/patterns/FormDialog/index.ts",
            "default": "./ts/src/patterns/FormDialog/index.ts"
        },
        "./patterns/useToasts": {
            "types": "./ts/src/patterns/useToasts.ts",
            "default": "./ts/src/patterns/useToasts.ts"
        },
        "./patterns/authenticated-data": {
            "types": "./ts/src/patterns/authenticated-data.svelte.ts",
            "default": "./ts/src/patterns/authenticated-data.svelte.ts"
        },
        "./patterns/selection-history": {
            "types": "./ts/src/patterns/selection-history.ts",
            "default": "./ts/src/patterns/selection-history.ts"
        },
        "./patterns/pagination-types": {
            "types": "./ts/src/patterns/pagination-types.ts",
            "default": "./ts/src/patterns/pagination-types.ts"
        },
        "./patterns/media-types": {
            "types": "./ts/src/patterns/media-types.ts",
            "default": "./ts/src/patterns/media-types.ts"
        },
        "./nightfire": {
            "svelte": "./ts/src/nightfire/index.ts",
            "types": "./ts/src/nightfire/index.ts",
            "default": "./ts/src/nightfire/index.ts"
        },
        "./validation": {
            "types": "./ts/src/validation/index.ts",
            "default": "./ts/src/validation/index.ts"
        },
        "./styles": {
            "svelte": "./ts/src/styles/index.ts",
            "types": "./ts/src/styles/index.ts",
            "default": "./ts/src/styles/index.ts"
        },
        "./client": {
            "types": "./ts/src/client/index.ts",
            "default": "./ts/src/client/index.ts"
        },
        "./client/http": {
            "types": "./ts/src/client/http.ts",
            "default": "./ts/src/client/http.ts"
        },
        "./client/errors": {
            "types": "./ts/src/client/errors.ts",
            "default": "./ts/src/client/errors.ts"
        },
        "./client/types": {
            "types": "./ts/src/client/types.ts",
            "default": "./ts/src/client/types.ts"
        },
        "./client/soft-delete": {
            "types": "./ts/src/client/soft-delete.ts",
            "default": "./ts/src/client/soft-delete.ts"
        },
        "./testing": {
            "types": "./ts/src/testing/index.ts",
            "default": "./ts/src/testing/index.ts"
        },
        "./server": {
            "types": "./ts/src/server/index.ts",
            "default": "./ts/src/server/index.ts"
        },
        "./utils": {
            "types": "./ts/src/utils/index.ts",
            "default": "./ts/src/utils/index.ts"
        },
        "./embed": {
            "types": "./ts/src/embed/index.ts",
            "default": "./ts/src/embed/index.ts"
        },
        "./styles/base.css": "./ts/src/styles/base.css",
        "./styles/forms.css": "./ts/src/styles/forms.css",
        "./styles/markdown-editor.css": "./ts/src/styles/markdown-editor.css",
        "./styles/tokens.css": "./ts/src/styles/tokens.css",
        "./styles/optimistic.css": "./ts/src/styles/optimistic.css"
    },
    "peerDependencies": {
        "@sveltejs/kit": "^2.53.0",
        "bits-ui": "^2.0.0",
        "lucide-svelte": "^0.563.0",
        "svelte": "^5.0.0",
        "vite": "^7.0.0",
        "zod": "^3.25.0"
    },
    "peerDependenciesMeta": {
        "zod": {
            "optional": true
        }
    },
    "dependencies": {
        "@poodle/svelte-composites": "file:../poodle/packages/svelte/composites",
        "@poodle/svelte-primitives": "file:../poodle/packages/svelte/primitives",
        "easymde": "^2.20.0",
        "isomorphic-dompurify": "^3.0.0",
        "marked": "^17.0.3",
        "svelte-dnd-action": "^0.9.69"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/svelte": "^5.3.1",
        "@types/node": "^25.3.0",
        "@vitest/coverage-v8": "^4.0.18",
        "@vitest/ui": "^4.0.18",
        "bits-ui": "^2.16.2",
        "lucide-svelte": "^0.575.0",
        "svelte": "^5.53.3",
        "svelte-check": "^4.4.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.0.18",
        "zod": "^3.25.0"
    },
    "guardrails": {
        "srcDir": "./ts/src",
        "extensions": [
            ".ts",
            ".svelte"
        ],
        "bannedPatterns": [],
        "moduleScopeChecks": "@decodelabs/underlay/tools/templates/sveltekit-ssr",
        "suppressionPrefix": "guardrails-disable"
    }
}
