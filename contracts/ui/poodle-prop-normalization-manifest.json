  "version": 1,
  "updated": "2026-03-25",
  "scope": "Public Poodle Svelte primitive and composite exports whose current public props use `is*` or `has*` boolean naming and therefore require a coordinated prop-language normalization sweep plus downstream call-site migration across Underlay and consuming apps.",
  "decision": {
    "canonical_boolean_prop_style": "plain_state_name",
    "rule": "Use plain boolean state names for public props across Poodle primitives and composites. Do not split naming style by primitive versus composite layer.",
    "examples": {
      "disabled": "preferred over isDisabled",
      "loading": "preferred over isLoading",
      "readonly": "preferred over isReadOnly",
      "required": "preferred over isRequired",
      "checked": "preferred over isChecked",
      "selected": "preferred over isSelected",
      "open": "preferred over isOpen",
      "collapsed": "preferred over isCollapsed"
    },
    "non_goal": "Do not preserve a permanent primitive/composite naming split such as `disabled` on some components and `isDisabled` on others."
  },
  "migration_scope": {
    "repos": [
      "poodle",
      "underlay",
      "acowtancy",
      "compli-me",
      "contact-patch",
      "songsprout",
      "underlay-reference"
    ],
    "notes": [
      "The sweep must update Poodle implementation, contracts, docs, and preview specimens together.",
      "Underlay and all six app groups must migrate their Poodle call sites in coordinated batches.",
      "Underlay roadmap 042 remains the broad UI-boundary migration umbrella; this manifest tracks the specific prop-language normalization dependency that now blocks clean migration work."
    ]
  },
  "audit_status": {
    "updated": "2026-03-25",
    "live_downstream_poodle_old_name_residue": "effectively_clear",
    "notes": [
      "A focused live-source audit across Underlay shared source, underlay-reference, and the six app groups found no meaningful remaining use of retired Poodle public `is*` or `has*` prop names.",
      "The final missed live residue was a small shared Underlay auth and guide-example tail, which has now been migrated.",
      "Remaining `is*` hits in live source are primarily Underlay-local helper or state naming and should not be treated as open Poodle prop normalization debt.",
      "Underlay now enforces a dedicated guardrail check that fails on reintroduced retired Poodle prop names in shared source and active guides."
    ]
  },
  "scan_baseline": {
    "poodle_public_components_with_is_or_has_props": 58,
    "downstream_poodle_import_matches_across_underlay_and_consuming_repos": 267,
    "notes": [
      "Component count was generated from the current public `.svelte` files under `packages/svelte/primitives/src` and `packages/svelte/composites/src`.",
      "Downstream import count is a coarse whole-portfolio signal for call-site migration scope, not a per-prop usage count."
    ]
  },
  "rename_policy": {
    "rename_groups": [
      {
        "from_prefixes": [
          "is"
        ],
        "to_style": "plain_state_name",
        "examples": [
          ["isDisabled", "disabled"],
          ["isLoading", "loading"],
          ["isPressed", "pressed"],
          ["isChecked", "checked"],
          ["isCollapsed", "collapsed"],
          ["isInteractive", "interactive"]
        ]
      },
      {
        "from_prefixes": [
          "has"
        ],
        "to_style": "plain_state_name",
        "examples": [
          ["hasMedia", "media"]
        ],
        "notes": [
          "Where a direct plain-state rename reads poorly, use the simplest domain-neutral noun or adjective instead of keeping `has*`."
        ]
      }
    ],
    "html_adjacency_rule": [
      "HTML-like control props should converge on the same plain-state naming rule instead of using a special primitive-only convention.",
      "Native attribute passthrough decisions remain separate from naming normalization and should be tracked independently in component contracts."
    ]
  },
