# Underlay migration scripts environment sample
# Copy to .env.local or export in your shell/CI.

# Optional shared config JSON path (default: ./migration.config.json)
# MIGRATION_CONFIG_FILE=./docs/guides/code/205-legacy-migration-framework/migration.config.sample.json

SOURCE_SYSTEM=legacy_site
TARGET_SCHEMA_VERSION=schema-v1
MEDIA_DIR=./legacy-export/media

# Build/publish
BUNDLE_FILE=./dist/migration-bundle.oci
BUNDLE_REF_FILE=./dist/migration-bundle.digest-ref.txt
OCI_REF_TAG=registry.example.com/underlay/site-migration:demo-20260302

# Run/report
OUTPUT_DIR=./runtime/demo-pass
RUN_REPORT=./runtime/demo-pass/run-report.json
GOVERNANCE_POLICY_FILE=./runtime/governance-policy.json

# Refresh/reuse
REUSE_FROM_DIGEST_REF_FILE=./dist/migration-bundle.digest-ref.txt
UNDERLAY_DEVTOOLS_CMD=underlay-devtools
APP_MIGRATION_RUNNER_CMD=cargo run -p myapp-migration -- run
PROJECT_NAME=acowtancy
DRIFT_MAX_UNRESOLVED=0
DRIFT_MAX_GOVERNANCE=0
DRIFT_MAX_LINEAGE=0
