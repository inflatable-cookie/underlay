{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underlay.local/schemas/migration-config.schema.json",
  "title": "Underlay Migration Script Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SOURCE_SYSTEM": { "type": "string", "minLength": 1 },
    "TARGET_SCHEMA_VERSION": { "type": "string", "minLength": 1 },
    "MEDIA_DIR": { "type": "string", "minLength": 1 },
    "BUNDLE_FILE": { "type": "string", "minLength": 1 },
    "OCI_REF_TAG": { "type": "string", "minLength": 1 },
    "BUNDLE_REF": { "type": "string", "pattern": ".+@sha256:[0-9a-f]{64}$" },
    "OUTPUT_DIR": { "type": "string", "minLength": 1 },
    "RUN_REPORT": { "type": "string", "minLength": 1 },
    "GOVERNANCE_POLICY_FILE": { "type": "string", "minLength": 1 },
    "REUSE_FROM_DIGEST_REF": { "type": "string", "pattern": ".+@sha256:[0-9a-f]{64}$" },
    "APP_MIGRATION_RUNNER_CMD": { "type": "string" },
    "DECISION_INDEX_FILE": { "type": "string", "minLength": 1 },
    "DECISION_JOURNAL_FILE": { "type": "string", "minLength": 1 },
    "DECISION_REUSE_SUMMARY_FILE": { "type": "string", "minLength": 1 },
    "DECISION_REUSE_SUMMARY_SCHEMA_FILE": { "type": "string", "minLength": 1 },
    "DECISION_REUSE_SUMMARY_LINT_FILE": { "type": "string", "minLength": 1 },
    "REFRESH_DRIFT_GATE_FILE": { "type": "string", "minLength": 1 },
    "REFRESH_DRIFT_GATE_SCHEMA_FILE": { "type": "string", "minLength": 1 },
    "REFRESH_DRIFT_GATE_LINT_FILE": { "type": "string", "minLength": 1 },
    "PROJECT_NAME": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "RUN_SCOPE": { "type": "string", "enum": ["demo", "refresh", "pre_production"] },
    "RUN_DATE_UTC": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "DOCTOR_REPORT": { "type": "string", "minLength": 1 },
    "VERIFY_ARTIFACT_FILE": { "type": "string", "minLength": 1 },
    "AUDIT_ARTIFACT_FILE": { "type": "string", "minLength": 1 },
    "ARTIFACT_MANIFEST_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_DECISION_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_DECISION_SCHEMA_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_DECISION_LINT_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_RELEASE_NOTE_JSON_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_RELEASE_NOTE_MD_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_CI_GUARD_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_CI_GUARD_SCHEMA_FILE": { "type": "string", "minLength": 1 },
    "PROMOTION_CI_GUARD_LINT_FILE": { "type": "string", "minLength": 1 },
    "DRIFT_MAX_UNRESOLVED": { "type": "string", "pattern": "^\\d+$" },
    "DRIFT_MAX_GOVERNANCE": { "type": "string", "pattern": "^\\d+$" },
    "DRIFT_MAX_LINEAGE": { "type": "string", "pattern": "^\\d+$" }
  }
}
