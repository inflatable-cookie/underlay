{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "underlay.migration.error_registry.schema.v1",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "codes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "underlay.migration.error_registry.v1"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "category",
          "scripts",
          "meaning",
          "remediation"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^MIG_[A-Z]+_[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "cli",
              "config",
              "evidence",
              "refresh",
              "promotion"
            ]
          },
          "scripts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2}_[a-z0-9_]+\\.ts$"
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
