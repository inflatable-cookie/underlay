{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underlay.local/schemas/migration-decision-reuse-summary.schema.json",
  "title": "Underlay Migration Decision Reuse Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "project_name",
    "run_scope",
    "run_date_utc",
    "reuse_from_digest_ref",
    "reuse_stats",
    "sidecar_merge",
    "suppression_kpi"
  ],
  "properties": {
    "schema": { "type": "string", "const": "underlay.migration.decision_reuse_summary.v1" },
    "schema_version": { "type": "number", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "project_name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "run_scope": { "type": "string", "const": "refresh" },
    "run_date_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reuse_from_digest_ref": { "type": "string", "pattern": ".+@sha256:[0-9a-f]{64}$" },
    "reuse_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reused_count", "new_count", "invalidated_count", "unresolved_count"],
      "properties": {
        "reused_count": { "type": "number", "minimum": 0 },
        "new_count": { "type": "number", "minimum": 0 },
        "invalidated_count": { "type": "number", "minimum": 0 },
        "unresolved_count": { "type": "number", "minimum": 0 }
      }
    },
    "sidecar_merge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deduped_count", "replaced_count", "invalidated_count", "corrupted_count"],
      "properties": {
        "deduped_count": { "type": "number", "minimum": 0 },
        "replaced_count": { "type": "number", "minimum": 0 },
        "invalidated_count": { "type": "number", "minimum": 0 },
        "corrupted_count": { "type": "number", "minimum": 0 }
      }
    },
    "suppression_kpi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_decisions_total",
        "reused_decisions_total",
        "new_ai_calls_total",
        "new_human_required_total",
        "invalidated_decisions_total",
        "ai_call_suppression_ratio",
        "reuse_ratio",
        "human_queue_ratio"
      ],
      "properties": {
        "candidate_decisions_total": { "type": "number", "minimum": 0 },
        "reused_decisions_total": { "type": "number", "minimum": 0 },
        "new_ai_calls_total": { "type": "number", "minimum": 0 },
        "new_human_required_total": { "type": "number", "minimum": 0 },
        "invalidated_decisions_total": { "type": "number", "minimum": 0 },
        "ai_call_suppression_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "reuse_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "human_queue_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_call_suppression_ratio_min", "reuse_ratio_min", "human_queue_ratio_max"],
      "properties": {
        "ai_call_suppression_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "reuse_ratio_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "human_queue_ratio_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
