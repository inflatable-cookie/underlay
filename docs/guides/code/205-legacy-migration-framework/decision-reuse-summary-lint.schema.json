{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underlay.local/schemas/migration-decision-reuse-summary-lint.schema.json",
  "title": "Underlay Migration Decision Reuse Summary Lint Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at",
    "summary_file",
    "schema_file",
    "status",
    "error_count",
    "errors"
  ],
  "properties": {
    "schema": { "type": "string", "const": "underlay.migration.decision_reuse_summary_lint.v1" },
    "schema_version": { "type": "number", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "summary_file": { "type": "string", "minLength": 1 },
    "schema_file": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "error_count": { "type": "number", "minimum": 0 },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
